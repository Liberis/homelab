[Unit]
Description=Prometheus smartctl Exporter
Documentation=https://github.com/prometheus-community/smartctl_exporter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/smartctl_exporter \
    --web.listen-address=:9633 \
    --smartctl.interval=60s
Restart=always
RestartSec=10

# Security hardening (where possible for privileged access)
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=false
PrivateTmp=true

[Install]
WantedBy=multi-user.target
